<?php
require_once __DIR__.'/../includes/bootstrap.php';

$q = trim($_GET['q'] ?? '');
$category = trim($_GET['category'] ?? 'all');

$categories = [
    'all' => 'all',
    'web' => 'cat_web',
    'programming' => 'cat_programming',
    'design' => 'cat_design',
    'security' => 'cat_security',
    'ai' => 'cat_ai',
    'data' => 'cat_data',
    'cloud' => 'cat_cloud'
];

/*
 * Keep the course page connected to the same courses table used by the home page.
 * Do not rely on hard-coded course IDs: existing/new courses will appear here too.
 */
$categoryKeywords = [
    'web' => ['HTML & CSS Fundamentals','JavaScript From Zero','Responsive Web Design'],
    'programming' => ['Python Programming','PHP & MySQL for Beginners','Git & Team Collaboration'],
    'design' => ['UI/UX Design'],
    'security' => ['Cybersecurity Essentials','Networking Fundamentals'],
    'ai' => ['AI & Machine Learning Starter','AI Tools for Everyday Work'],
    'data' => ['Data Analysis with Excel & SQL'],
    'cloud' => []
];

$where = "WHERE status='published'";
$params = [];

if ($q !== '') {
    $where .= " AND (title_en LIKE ? OR title_ar LIKE ? OR title_ckb LIKE ? OR title_badini LIKE ? OR description_en LIKE ? OR description_ar LIKE ? OR description_ckb LIKE ? OR description_badini LIKE ?)";
    $like = "%{$q}%";
    $params = [$like,$like,$like,$like,$like,$like,$like,$like];
}

$stmt = $pdo->prepare("SELECT * FROM courses {$where} ORDER BY id DESC");
$stmt->execute($params);
$courses = $stmt->fetchAll(PDO::FETCH_ASSOC);

/* Filter categories in PHP so the page never depends on specific database IDs. */
if ($category !== 'all' && isset($categoryKeywords[$category])) {
    $names = $categoryKeywords[$category];
    if ($names) {
        $courses = array_values(array_filter($courses, function($course) use ($names) {
            return in_array($course['title_en'], $names, true);
        }));
    } else {
        $courses = [];
    }
}

foreach ($courses as &$course) {
    $course = localizedCourse($course);
}
unset($course);

function courseCategoryKey(array $course): string {
    $title = $course['title_en'] ?? '';
    if (in_array($title, ['HTML & CSS Fundamentals','JavaScript From Zero','Responsive Web Design'], true)) return 'web';
    if (in_array($title, ['Python Programming','PHP & MySQL for Beginners','Git & Team Collaboration'], true)) return 'programming';
    if ($title === 'UI/UX Design') return 'design';
    if (in_array($title, ['Cybersecurity Essentials','Networking Fundamentals'], true)) return 'security';
    if (in_array($title, ['AI & Machine Learning Starter','AI Tools for Everyday Work'], true)) return 'ai';
    if ($title === 'Data Analysis with Excel & SQL') return 'data';
    return 'web';
}

function courseDuration(int $id, string $lang): string {
    $ar = [1=>'6 أسابيع',2=>'8 أسابيع',3=>'5 أسابيع',4=>'7 أسابيع',5=>'8 أسابيع',6=>'10 أسابيع',7=>'6 أسابيع',8=>'7 أسابيع',9=>'7 أسابيع',10=>'8 أسابيع',11=>'10 أسابيع',12=>'8 أسابيع'];
    $en = [1=>'6 weeks',2=>'8 weeks',3=>'5 weeks',4=>'7 weeks',5=>'8 weeks',6=>'10 weeks',7=>'6 weeks',8=>'7 weeks',9=>'7 weeks',10=>'8 weeks',11=>'10 weeks',12=>'8 weeks'];
    $ckb = [1=>'٦ هەفتە',2=>'٨ هەفتە',3=>'٥ هەفتە',4=>'٧ هەفتە',5=>'٨ هەفتە',6=>'١٠ هەفتە',7=>'٦ هەفتە',8=>'٧ هەفتە',9=>'٧ هەفتە',10=>'٨ هەفتە',11=>'١٠ هەفتە',12=>'٨ هەفتە'];
    $badini = [1=>'6 hefte',2=>'8 hefte',3=>'5 hefte',4=>'7 hefte',5=>'8 hefte',6=>'10 hefte',7=>'6 hefte',8=>'7 hefte',9=>'7 hefte',10=>'8 hefte',11=>'10 hefte',12=>'8 hefte'];
    $map = $lang === 'ar' ? $ar : ($lang === 'ckb' ? $ckb : ($lang === 'kurdish_badini' ? $badini : $en));
    return $map[$id] ?? ($lang === 'en' ? '8 weeks' : ($lang === 'ar' ? '8 أسابيع' : '٨ هەفتە'));
}

$pageTitle = t('courses');
require __DIR__.'/../includes/header.php';
?>

<section class="section course-catalog">
    <div class="container">
        <div class="catalog-hero">
            <div>
                <span class="eyebrow"><?=t('learn_build_lead')?></span>
                <h1><?=t('courses')?></h1>
                <p class="muted"><?=t('courses_intro')?></p>
            </div>
            <div class="catalog-stats">
                <div><strong><?=count($courses)?></strong><span><?=t('available_courses')?></span></div>
                <div><strong>6</strong><span><?=t('learning_paths')?></span></div>
                <div><strong>100%</strong><span><?=t('practical_learning')?></span></div>
            </div>
        </div>

        <form class="card course-search" method="get">
            <input type="hidden" name="lang" value="<?=e($lang)?>">
            <input class="field" style="margin:0;flex:1;padding:13px;border:1px solid #ddd;border-radius:10px" name="q" value="<?=e($q)?>" placeholder="<?=t('search_courses_placeholder')?>">
            <input type="hidden" name="category" value="<?=e($category)?>">
            <button class="btn" type="submit"><?=t('search')?></button>
        </form>

        <div class="course-filters" aria-label="<?=t('course_categories')?>">
            <?php foreach ($categories as $key=>$labelKey): ?>
                <a class="filter-chip <?=$category === $key ? 'active' : ''?>" href="?lang=<?=e($lang)?>&category=<?=e($key)?><?= $q !== '' ? '&q='.urlencode($q) : '' ?>">
                    <?=t($labelKey)?>
                </a>
            <?php endforeach; ?>
        </div>

        <?php if (!$courses): ?>
            <div class="card empty-state">
                <div class="feature-icon">📚</div>
                <h2><?=t('no_courses_found')?></h2>
                <p class="muted"><?=t('no_courses_found_desc')?></p>
                <a class="btn" href="?lang=<?=e($lang)?>&category=all"><?=t('show_all_courses')?></a>
            </div>
        <?php else: ?>
            <!-- The cards below are the same database courses shown on the home page. -->
            <div class="course-grid" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;width:100%;">
                <?php foreach ($courses as $c):
                    $cid = (int)$c['id'];
                    $titleColumn = localizedColumn('title');
                    $descriptionColumn = localizedColumn('description');
                    $title = trim((string)($c[$titleColumn] ?? '')) !== '' ? $c[$titleColumn] : $c['title_en'];
                    $description = trim((string)($c[$descriptionColumn] ?? '')) !== '' ? $c[$descriptionColumn] : $c['description_en'];
                    $courseCategory = courseCategoryKey($c);
                    $price = (int)($c['price_iqd'] ?? 0);
                ?>
                    <article class="card course-card enhanced-course-card" style="display:flex;flex-direction:column;min-width:0;visibility:visible;opacity:1;">
                        <div class="course-cover" style="display:flex;min-height:170px;">
                            <span class="course-number">#<?=$cid?></span>
                            <strong><?=e($title)?></strong>
                        </div>
                        <div class="course-meta">
                            <span><?=e($c['level'] ?? '')?></span>
                            <span class="pill"><?=($c['type'] ?? '') === 'free' ? t('free') : (($c['type'] ?? '') === 'mixed' ? t('mixed') : t('paid'))?></span>
                        </div>
                        <div class="course-category-label"><?=t('cat_'.$courseCategory)?></div>
                        <h2><?=e($title)?></h2>
                        <p class="muted"><?=e($description)?></p>
                        <div class="course-info-row">
                            <span>⏱ <?=e(courseDuration($cid,$lang))?></span>
                            <span>📚 <?=e((string)($c['lessons_count'] ?? 0))?> <?=t('lessons')?></span>
                        </div>
                        <div class="course-bottom">
                            <span class="price"><?=$price > 0 ? number_format($price).' '.t('iqd') : t('free')?></span>
                            <a class="btn" href="details.php?id=<?=$cid?>&lang=<?=e($lang)?>"><?=t('learn_more')?></a>
                        </div>
                    </article>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>
    </div>
</section>

<?php require __DIR__.'/../includes/footer.php'; ?>
